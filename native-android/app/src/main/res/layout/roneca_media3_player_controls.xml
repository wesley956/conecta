<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <View
        android:id="@id/exo_controls_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/exo_black_opacity_60" />

    <LinearLayout
        android:id="@+id/roneca_media3_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#D9080809"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/roneca_media3_back"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Voltar"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusDown="@id/exo_play_pause"
            android:text="←"
            android:textColor="#F7F7F8"
            android:textSize="22sp" />

        <View
            android:layout_width="3dp"
            android:layout_height="28dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="9dp"
            android:background="#E3262E" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/roneca_media3_eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="RONECAPLAYTV"
                    android:textColor="#FF454C"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/roneca_media3_live"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text="● AO VIVO"
                    android:textColor="#FF454C"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/roneca_media3_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F7F7F8"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/roneca_media3_subtitles"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="7dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="Escolher legenda"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="82dp"
            android:nextFocusDown="@id/exo_play_pause"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="CC  Legendas"
            android:textColor="#F7F7F8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/roneca_media3_aspect"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="7dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="Alterar aspecto da imagem"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="72dp"
            android:nextFocusDown="@id/exo_play_pause"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Original"
            android:textColor="#F7F7F8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/roneca_media3_drawer"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="7dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="78dp"
            android:nextFocusDown="@id/exo_play_pause"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="#F7F7F8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@id/exo_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/exo_styled_bottom_bar_height"
        android:layout_gravity="bottom"
        android:layout_marginTop="@dimen/exo_styled_bottom_bar_margin_top"
        android:background="@color/exo_bottom_bar_background"
        android:layoutDirection="ltr">

        <LinearLayout
            android:id="@id/exo_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:importantForAccessibility="noHideDescendants"
            android:layoutDirection="ltr"
            android:paddingStart="@dimen/exo_styled_bottom_bar_time_padding"
            android:paddingEnd="@dimen/exo_styled_bottom_bar_time_padding">

            <TextView
                android:id="@id/exo_position"
                style="@style/ExoStyledControls.TimeText.Position" />

            <TextView style="@style/ExoStyledControls.TimeText.Separator" />

            <TextView
                android:id="@id/exo_duration"
                style="@style/ExoStyledControls.TimeText.Duration" />
        </LinearLayout>

        <LinearLayout
            android:id="@id/exo_basic_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:layoutDirection="ltr">

            <ImageButton
                android:id="@id/exo_settings"
                style="@style/ExoStyledControls.Button.Bottom.Settings" />
        </LinearLayout>
    </FrameLayout>

    <View
        android:id="@id/exo_progress_placeholder"
        android:layout_width="match_parent"
        android:layout_height="@dimen/exo_styled_progress_layout_height"
        android:layout_gravity="bottom"
        android:layout_marginBottom="@dimen/exo_styled_progress_margin_bottom"
        android:focusable="true" />

    <LinearLayout
        android:id="@id/exo_center_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:gravity="center"
        android:layoutDirection="ltr"
        android:padding="@dimen/exo_styled_controls_padding">

        <include layout="@layout/exo_player_control_rewind_button" />

        <ImageButton
            android:id="@id/exo_play_pause"
            style="@style/ExoStyledControls.Button.Center.PlayPause"
            android:nextFocusUp="@id/roneca_media3_back" />

        <include layout="@layout/exo_player_control_ffwd_button" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/exo_top_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:background="@android:color/transparent">

        <View
            android:id="@+id/exo_media_route_button_placeholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>

</merge>

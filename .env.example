# Painel de ativação / liberação de aparelhos
VITE_ENABLE_DEVICE_PANEL=true
VITE_DEVICE_CONFIG_URL=https://seu-painel.com/api/device-config

# Servidor Node opcional (server.mjs)
PORT=4173

# Segurança do proxy Node:
# Separe hosts por vírgula. Exemplo:
# RONECA_PROXY_ALLOWED_HOSTS=cdn.exemplo.com,stream.exemplo.com
RONECA_PROXY_ALLOWED_HOSTS=

# Mantenha false em produção. Use true apenas para testes locais controlados.
RONECA_ALLOW_PRIVATE_PROXY=false

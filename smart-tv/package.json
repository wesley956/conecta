{
  "name": "@roneca/smart-tv",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "stage:webos": "npm run build && node scripts/stage-platform.mjs webos",
    "stage:tizen": "npm run build && node scripts/stage-platform.mjs tizen",
    "package:webos": "npm run stage:webos && node scripts/package-webos.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "vite": "7.1.12",
    "typescript": "5.9.3",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2"
  }
}
